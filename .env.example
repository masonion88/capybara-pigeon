PORT=3000
# Set to false to keep events on their authored date instead of shifting them to today
REBASE_EVENTS=true

# Routing (walking). The public router.project-osrm.org demo server only does driving.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_PROFILE=foot
OSRM_TIMEOUT_MS=8000

# Capital One Nessie (plain http:// connections get reset; use https)
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_API_KEY=
# Filled in by: npm run seed:nessie
NESSIE_CUSTOMER_ID=
NESSIE_ACCOUNT_ID=
NESSIE_ORGANIZER_ACCOUNT_ID=
# Balance returned when Nessie is unreachable or rate-limits us
NESSIE_FALLBACK_BALANCE=18

# Google Gemini (pit-stop agent)
GEMINI_API_KEY=
# Comma-separated; tried in order, falls back to rule-based copy if all fail
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest
GEMINI_TIMEOUT_MS=8000

# Photon Spectrum (iMessage). Live texts go to MY_PHONE_NUMBER only; blank = mock delivery.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
MY_PHONE_NUMBER=
